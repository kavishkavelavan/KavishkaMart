<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>KavishkaMart Web Application</display-name>

    <!-- Session Timeout (30 Minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure> <!-- Set to true in HTTPS production -->
        </cookie-config>
    </session-config>

    <!-- ServletContextListener for Connection Pool Lifecycle -->
    <listener>
        <listener-class>com.kavishka.kavishkamart.listener.AppContextListener</listener-class>
    </listener>

    <!-- Encoding Filter -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.kavishka.kavishkamart.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- MDC Request ID Filter -->
    <filter>
        <filter-name>MdcLoggingFilter</filter-name>
        <filter-class>com.kavishka.kavishkamart.filter.MdcLoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>MdcLoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Auth Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.kavishka.kavishkamart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/checkout/*</url-pattern>
        <url-pattern>/orders/*</url-pattern>
    </filter-mapping>

    <!-- Custom Error Pages (No Stack Trace Expose - Spec Rule 9) -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
<servlet>
    <servlet-name>CartApiServlet</servlet-name>
    <servlet-class>com.kavishka.kavishkamart.controller.CartApiServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>CartApiServlet</servlet-name>
    <url-pattern>/api/cart/*</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>CartPageServlet</servlet-name>
    <servlet-class>com.kavishka.kavishkamart.controller.CartPageServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>CartPageServlet</servlet-name>
    <url-pattern>/seller/cart</url-pattern>
    <url-pattern>/cart</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>ChatServlet</servlet-name>
    <servlet-class>com.kavishka.kavishkamart.controller.ChatServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>ChatServlet</servlet-name>
    <url-pattern>/api/v1/chat</url-pattern>
    <url-pattern>/api/chat</url-pattern>
</servlet-mapping>
</web-app>
